    return connection
end

local function keyText(key)
    if key then
        return string.upper(key.Name)
    end
    return "NONE"
end

local function tween(object, duration, properties, style, direction)
    if not object or not object.Parent then
        return nil
    end

    local info = TweenInfo.new(
        duration,
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out
    )

    local animation = TweenService:Create(object, info, properties)
    table.insert(animations, animation)

    -- Remove completed/cancelled tweens so slider drags and repeated hovers
    -- don't leave an ever-growing animation list behind.
    local completedConnection
    completedConnection = animation.Completed:Connect(function()
        if completedConnection then
            completedConnection:Disconnect()
        end
        for index = #animations, 1, -1 do
            if animations[index] == animation then
                table.remove(animations, index)
                break
            end
        end
    end)

    animation:Play()
    return animation
end

local function addLoopingTween(object, duration, properties)
    local info = TweenInfo.new(
        duration,
        Enum.EasingStyle.Sine,
        Enum.EasingDirection.InOut,
        -1,
        true
    )
    local animation = TweenService:Create(object, info, properties)
    table.insert(animations, animation)
    animation:Play()
    return animation
end


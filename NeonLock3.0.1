---------------------------------------------------------------------
-- BUTTON PAINTING / RIPPLE
---------------------------------------------------------------------

local function paintButton(button, instant)
    local meta = buttonMeta[button]
    if not meta or not button.Parent then
        return
    end

    local bg
    local fg
    local borderAlpha
    local borderWidth
    local scale

    if meta.active then
        bg = meta.activeColor or accentSoft
        fg = meta.activeTextColor or COLORS.text
        borderAlpha = 0.02
        borderWidth = 1.5
        scale = meta.hover and 1.025 or 1
    elseif meta.hover then
        bg = COLORS.buttonHover
        fg = COLORS.text
        borderAlpha = 0.12
        borderWidth = 1.25
        scale = 1.025
    else
        bg = meta.baseColor or COLORS.button
        fg = COLORS.text
        borderAlpha = 0.53
        borderWidth = 1
        scale = 1
    end

    local duration = instant and 0 or 0.16
    tween(button, duration, {BackgroundColor3 = bg, TextColor3 = fg})
    tween(meta.stroke, duration, {
        Color = accent,
        Transparency = borderAlpha,
        Thickness = borderWidth,
    })
    tween(meta.scale, duration, {Scale = scale}, Enum.EasingStyle.Back)
end

local function setButtonActive(button, active, activeColor, activeTextColor)
    local meta = buttonMeta[button]
    if not meta then
        return
    end
    meta.active = active
    meta.activeColor = activeColor
    meta.activeTextColor = activeTextColor
    paintButton(button, false)
end

local function ripple(button, input)
    if not button or not button.Parent or not input then
        return
    end

    -- Offsets inside the window are scaled by its UIScales, so convert
    -- screen pixels back to local units.
    local uiScale = math.max(responsiveScale.Scale * frameScale.Scale, 0.01)
    local relativeX = (input.Position.X - button.AbsolutePosition.X) / uiScale
    local relativeY = (input.Position.Y - button.AbsolutePosition.Y) / uiScale
    local largest = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) / uiScale
    local size = largest * 2.15

    local circle = make("Frame", {
        Name = "Ripple",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(relativeX, relativeY),
        Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = COLORS.text,
        BackgroundTransparency = 0.67,
        BorderSizePixel = 0,
        ZIndex = button.ZIndex + 1,
    }, button)
    round(circle, 200)

    tween(circle, 0.44, {
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
    }, Enum.EasingStyle.Quart)

    task.delay(0.5, function()
        if circle.Parent then
            circle:Destroy()
        end
    end)
end

local function uiButton(text, x, y, width, height, parent, options)
    options = options or {}
    local button = make("TextButton", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = options.baseColor or COLORS.button,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = options.textColor or COLORS.text,
        Font = options.font or Enum.Font.GothamBold,
        TextSize = options.textSize or 11,
        AutoButtonColor = false,
        ClipsDescendants = true,
        ZIndex = options.zIndex or 4,
    }, parent)

    round(button, options.radius or 8)
    local buttonStroke = stroke(button, accent, 1, 0.53)
    gradient(button, ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(208, 199, 226)),
    }), 90)

    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = button

    buttonMeta[button] = {
        stroke = buttonStroke,
        scale = scale,
        hover = false,
        active = false,
        baseColor = options.baseColor or COLORS.button,
        activeColor = options.activeColor,
        activeTextColor = options.activeTextColor,
    }

    remember(button.MouseEnter:Connect(function()
        if buttonMeta[button] then
            buttonMeta[button].hover = true
            paintButton(button, false)
        end
    end))

    remember(button.MouseLeave:Connect(function()
        if buttonMeta[button] then
            buttonMeta[button].hover = false
            paintButton(button, false)
        end
    end))

    remember(button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            ripple(button, input)
            tween(scale, 0.07, {Scale = 0.95}, Enum.EasingStyle.Quad)
        end
    end))

    remember(button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            task.defer(function()
                if button.Parent then
                    paintButton(button, false)
                end
            end)
        end
    end))

    return button
end

-- Shrinks long text (like "RANDOM  /  RIGHTCONTROL") to fit the button
-- instead of overflowing it. Used on the narrower bind buttons.
local function fitButtonText(button, maxSize)
    button.TextScaled = true
    local constraint = Instance.new("UITextSizeConstraint")
    constraint.MaxTextSize = maxSize or 11
    constraint.MinTextSize = 6
    constraint.Parent = button
end


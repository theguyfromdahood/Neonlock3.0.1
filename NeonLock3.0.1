-- The window is 390 wide, the side panel hangs off its right edge
-- (8px gap + 232px wide), so the whole thing is 630 wide.
local TOTAL_WIDTH = 630
local SIDE_OFFSET = 398
local SIDE_WIDTH = 232

local viewportConnection
local function fitWindowToViewport()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local fitX = (viewport.X - 24) / TOTAL_WIDTH
    local fitY = (viewport.Y - 24) / 600
    responsiveScale.Scale = math.clamp(math.min(fitX, fitY), 0.45, 1)
    syncShadowPosition()
end

local function watchCameraViewport(camera)
    if viewportConnection then
        viewportConnection:Disconnect()
        viewportConnection = nil
    end
    if camera then
        viewportConnection = remember(
            camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitWindowToViewport)
        )
    end
end

fitWindowToViewport()
-- Shift the window left so the window + side panel together are centred.
frame.Position = UDim2.new(0.5, -((SIDE_OFFSET + SIDE_WIDTH - 390) / 2) * responsiveScale.Scale, 0.5, 0)
watchCameraViewport(workspace.CurrentCamera)
remember(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    watchCameraViewport(workspace.CurrentCamera)
    fitWindowToViewport()
end))


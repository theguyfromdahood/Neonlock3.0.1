local function createSlider(name, y, minValue, maxValue, initial, precision, parent, readoutLabel, callback)
    local slider = {
        min = minValue,
        max = maxValue,
        value = initial,
        precision = precision,
        callback = callback,
        readout = readoutLabel,
    }

    slider.bar = make("TextButton", {
        Position = UDim2.fromOffset(12, y),
        Size = UDim2.new(1, -24, 0, 10),
        BackgroundColor3 = COLORS.button,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Active = true,
        ClipsDescendants = false,
        ZIndex = 4,
    }, parent)
    round(slider.bar, 8)
    stroke(slider.bar, accent, 1, 0.65)

    slider.fill = make("Frame", {
        Size = UDim2.new((initial - minValue) / (maxValue - minValue), 0, 1, 0),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, slider.bar)
    round(slider.fill, 8)
    slider.fillGradient = gradient(slider.fill, ColorSequence.new(COLORS.text, accent), 0)

    slider.knob = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((initial - minValue) / (maxValue - minValue), 0, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = COLORS.text,
        BorderSizePixel = 0,
        ZIndex = 6,
    }, slider.bar)
    round(slider.knob, 20)
    slider.knobStroke = stroke(slider.knob, accent, 2, 0)
    slider.knobScale = Instance.new("UIScale")
    slider.knobScale.Scale = 1
    slider.knobScale.Parent = slider.knob

    function slider:update(screenX)
        local width = self.bar.AbsoluteSize.X
        if width <= 0 then
            return
        end

        local fraction = math.clamp(
            (screenX - self.bar.AbsolutePosition.X) / width,
            0,
            1
        )
        local precisionScale = 10 ^ self.precision
        local rawValue = self.min + fraction * (self.max - self.min)
        self.value = math.clamp(
            math.floor(rawValue * precisionScale + 0.5) / precisionScale,
            self.min,
            self.max
        )

        local normalized = (self.value - self.min) / (self.max - self.min)
        self.fill.Size = UDim2.new(normalized, 0, 1, 0)
        self.knob.Position = UDim2.new(normalized, 0, 0.5, 0)
        self.readout.Text = string.format("%s", tostring(self.value))
        self.callback(self.value)
    end

    remember(slider.bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = slider
            slider:update(input.Position.X)
            tween(slider.knobScale, 0.12, {Scale = 1.22}, Enum.EasingStyle.Back)
        end
    end))

    table.insert(sliders, slider)
    return slider
end


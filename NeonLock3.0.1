---------------------------------------------------------------------
-- KEYBOARD INPUT
---------------------------------------------------------------------

remember(UIS.InputBegan:Connect(function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if listening then
        if input.KeyCode == Enum.KeyCode.Unknown then
            return
        end

        if input.KeyCode == Enum.KeyCode.Escape then
            local cancelledButton = listeningButton
            listening = nil
            listeningButton = nil
            refreshBindButtonNames()
            if cancelledButton then
                setButtonActive(cancelledButton, false)
            end
            setButtonActive(lockButton, locked, accent, COLORS.background)
            setButtonActive(purpleButton, themeName == "Purple")
            setButtonActive(greenButton, themeName == "Green")
            setButtonActive(guiToggleButton, guiKeyEnabled)
            return
        end

        if listening == "Lock" then
            lockKey = input.KeyCode
        elseif listening == "Random" then
            randomKey = input.KeyCode
        elseif listening == "Speed" then
            speedKey = input.KeyCode
        elseif listening == "Flight" then
            flightKey = input.KeyCode
        elseif listening == "GUI" then
            guiKey = input.KeyCode
        end

        local completedButton = listeningButton
        listening = nil
        listeningButton = nil
        refreshBindButtonNames()
        setButtonActive(completedButton, false)
        if locked then
            setButtonActive(lockButton, true, accent, COLORS.background)
        end
        showToast("KEYBIND UPDATED", accent)
        return
    end

    -- Don't fire hotkeys while typing in a text box (search, speed, flight).
    if UIS:GetFocusedTextBox() then
        return
    end

    if guiKeyEnabled and guiKey and input.KeyCode == guiKey then
        if frame.Visible then
            hideWindow()
        else
            showWindow()
        end
        return
    end

    if processed then
        return
    end

    if lockKey and input.KeyCode == lockKey then
        toggleLock()
    elseif randomKey and input.KeyCode == randomKey then
        partIndex = math.random(1, #parts)
        updatePartButtons()
        updateLockedPart()
    elseif speedKey and input.KeyCode == speedKey then
        toggleSpeed()
    elseif flightKey and input.KeyCode == flightKey then
        toggleFlight()
    end
end))


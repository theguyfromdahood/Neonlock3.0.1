-- Separate full-screen ScreenGui that ignores the top-bar inset, so GUI
-- pixels line up exactly with camera:WorldToViewportPoint coordinates.
local espGui = Instance.new("ScreenGui")
espGui.Name = "NeonLockESP"
espGui.ResetOnSpawn = false
espGui.IgnoreGuiInset = true
espGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
espGui.DisplayOrder = 10
pcall(function()
    espGui.ScreenInsets = Enum.ScreenInsets.None
end)
espGui.Parent = playerGui

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local HEALTH_LOW = Color3.fromRGB(255, 70, 70)
local HEALTH_HIGH = Color3.fromRGB(80, 255, 120)

local function getEspColor()
    return ESP_COLORS[espColorIndex].color or accent
end

local function createEsp()
    local obj = {}

    obj.root = make("Frame", {
        Name = "ESP",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 1,
    }, espGui)

    obj.box = make("Frame", {
        Name = "Box",
        BackgroundColor3 = WHITE,
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 2,
    }, obj.root)
    obj.boxStroke = stroke(obj.box, WHITE, 1.5, 0)

    obj.healthBack = make("Frame", {
        Name = "HealthBack",
        BackgroundColor3 = BLACK,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 2,
    }, obj.root)
    obj.healthFill = make("Frame", {
        Name = "HealthFill",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.fromScale(0, 1),
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = HEALTH_HIGH,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, obj.healthBack)

    obj.nameLabel = make("TextLabel", {
        Name = "Name",
        Size = UDim2.fromOffset(200, 14),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = WHITE,
        TextStrokeColor3 = BLACK,
        TextStrokeTransparency = 0.35,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        Visible = false,
        ZIndex = 4,
    }, obj.root)

    obj.infoLabel = make("TextLabel", {
        Name = "Info",
        Size = UDim2.fromOffset(200, 13),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = WHITE,
        TextStrokeColor3 = BLACK,
        TextStrokeTransparency = 0.4,
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        Visible = false,
        ZIndex = 4,
    }, obj.root)

    obj.tracer = make("Frame", {
        Name = "Tracer",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(0, 2),
        BackgroundColor3 = WHITE,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 2,
    }, obj.root)

    obj.tracerDot = make("Frame", {
        Name = "TracerDot",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(8, 8),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 3,
    }, obj.root)
    round(obj.tracerDot, 8)

    obj.highlight = nil
    return obj
end

local function hideEsp(obj)
    if obj.root.Visible then
        obj.root.Visible = false
    end
    if obj.highlight and obj.highlight.Enabled then
        obj.highlight.Enabled = false
    end
end

local function destroyEsp(obj)
    if obj.highlight then
        obj.highlight:Destroy()
        obj.highlight = nil
    end
    if obj.root then
        obj.root:Destroy()
    end
end

local function updateEspFor(other, isTarget, camera, screenSize, color)
    local obj = espObjects[other]
    if not obj then
        obj = createEsp()
        espObjects[other] = obj
    end

    local character = other.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    -- The tracer always uses the torso (R15 UpperTorso, R6 Torso), falling
    -- back to the root part only if neither exists.
    local torso = character and (
        character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or root
    )

    if not humanoid or not root or not torso
        or not root:IsA("BasePart") or not torso:IsA("BasePart")
        or humanoid.Health <= 0 then
        hideEsp(obj)
        return
    end

    obj.root.Visible = true
    local thickness = isTarget and 2.5 or 1.5

    -- GLOW (Highlight) ------------------------------------------------
    if espGlowEnabled then
        local highlight = obj.highlight
        if not highlight or highlight.Parent ~= character then
            if highlight then
                highlight:Destroy()
            end
            highlight = Instance.new("Highlight")
            highlight.Name = "NeonLockHighlight"
            highlight.Adornee = character
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.OutlineTransparency = 0.1
            highlight.Parent = character
            obj.highlight = highlight
        end
        highlight.Enabled = true
        highlight.FillColor = color
        highlight.OutlineColor = color:Lerp(WHITE, 0.35)
        highlight.FillTransparency = isTarget and 0.5 or 0.72
    elseif obj.highlight then
        obj.highlight.Enabled = false
    end

    -- BOX / HEALTH / NAME ---------------------------------------------
    -- Fixed-size upright box around the root part so it never wobbles with
    -- animations or accessories.
    local rootPosition = root.Position
    local topPoint = camera:WorldToViewportPoint(rootPosition + Vector3.new(0, 3, 0))
    local bottomPoint = camera:WorldToViewportPoint(rootPosition - Vector3.new(0, 3.5, 0))
    local inFront = topPoint.Z > 0 and bottomPoint.Z > 0

    if inFront then
        local height = math.max(math.abs(bottomPoint.Y - topPoint.Y), 4)
        local width = height * 0.58
        local centerX = (topPoint.X + bottomPoint.X) / 2
        local topY = math.min(topPoint.Y, bottomPoint.Y)
        local left = centerX - width / 2
        local fraction = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)

        if espBoxEnabled then
            obj.box.Position = UDim2.fromOffset(left, topY)
            obj.box.Size = UDim2.fromOffset(width, height)
            obj.box.BackgroundColor3 = color
            obj.box.BackgroundTransparency = isTarget and 0.8 or 0.9
            obj.boxStroke.Color = color
            obj.boxStroke.Thickness = thickness
            obj.box.Visible = true

            obj.healthBack.Position = UDim2.fromOffset(left - 6, topY)
            obj.healthBack.Size = UDim2.fromOffset(3, height)
            obj.healthFill.Size = UDim2.fromScale(1, fraction)
            obj.healthFill.BackgroundColor3 = HEALTH_LOW:Lerp(HEALTH_HIGH, fraction)
            obj.healthBack.Visible = true
        else
            obj.box.Visible = false
            obj.healthBack.Visible = false
        end

        if espNameEnabled then
            local distance = (camera.CFrame.Position - rootPosition).Magnitude
            obj.nameLabel.Position = UDim2.fromOffset(centerX - 100, topY - 16)
            obj.nameLabel.Text = (isTarget and "[TARGET]  " or "") .. other.DisplayName
            obj.nameLabel.TextColor3 = color
            obj.nameLabel.Visible = true

            obj.infoLabel.Position = UDim2.fromOffset(centerX - 100, topY + height + 2)
            obj.infoLabel.Text = string.format(
                "%d studs  |  %d HP",
                math.floor(distance + 0.5),
                math.floor(humanoid.Health + 0.5)
            )
            obj.infoLabel.Visible = true
        else
            obj.nameLabel.Visible = false
            obj.infoLabel.Visible = false
        end
    else
        obj.box.Visible = false
        obj.healthBack.Visible = false
        obj.nameLabel.Visible = false
        obj.infoLabel.Visible = false
    end

    -- TRACER ------------------------------------------------------------
    -- From the bottom-centre of the screen to the target's torso.
    if espTracerEnabled then
        local startPoint = Vector2.new(screenSize.X / 2, screenSize.Y)
        local torsoPoint = camera:WorldToViewportPoint(torso.Position)
        local torsoInFront = torsoPoint.Z > 0
        local finishPoint

        if torsoInFront then
            finishPoint = Vector2.new(torsoPoint.X, torsoPoint.Y)
        else
            -- Behind the camera the projected point is mirrored, so use the
            -- real direction (in camera space) and point the tracer that way.
            local relative = camera.CFrame:PointToObjectSpace(torso.Position)
            local direction = Vector2.new(relative.X, -relative.Y)
            if direction.Magnitude < 0.01 then
                direction = Vector2.new(0, 1)
            end
            finishPoint = screenSize / 2 + direction.Unit * screenSize.Magnitude
        end

        local delta = finishPoint - startPoint
        local length = delta.Magnitude
        if length > 6000 then
            delta = delta.Unit * 6000
            finishPoint = startPoint + delta
            length = 6000
        end

        local middle = startPoint + delta / 2
        obj.tracer.Position = UDim2.fromOffset(middle.X, middle.Y)
        obj.tracer.Size = UDim2.fromOffset(length, thickness)
        obj.tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
        obj.tracer.BackgroundColor3 = color
        obj.tracer.Visible = true

        obj.tracerDot.Position = UDim2.fromOffset(finishPoint.X, finishPoint.Y)
        obj.tracerDot.BackgroundColor3 = color
        obj.tracerDot.Visible = torsoInFront
    else
        obj.tracer.Visible = false
        obj.tracerDot.Visible = false
    end
end

local function updateEsp()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local screenSize = espGui.AbsoluteSize
    local color = getEspColor()
    local targetPlayer = selectedPlayer

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local isTarget = (targetPlayer ~= nil and other == targetPlayer)
            local shouldShow = espAllEnabled or (espTargetEnabled and isTarget)

            if shouldShow then
                updateEspFor(other, isTarget, camera, screenSize, color)
            else
                local obj = espObjects[other]
                if obj then
                    hideEsp(obj)
                end
            end
        end
    end
end

-- Runs after the camera-lock step so the tracer/box use the final camera.
RunService:BindToRenderStep(
    "NeonLockESP",
    Enum.RenderPriority.Camera.Value + 2,
    updateEsp
)


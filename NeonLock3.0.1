local function applyTheme(name)
    themeName = name
    local theme = THEMES[name]
    accent = theme.accent
    accentSoft = theme.soft

    tween(frameStroke, 0.25, {Color = accent})
    tween(shadow, 0.25, {BackgroundColor3 = accent})
    tween(header, 0.25, {BackgroundColor3 = accentSoft})
    tween(headerBottom, 0.25, {BackgroundColor3 = accent})
    tween(statusDot, 0.25, {BackgroundColor3 = accent})
    mainPage.ScrollBarImageColor3 = accent
    playerList.ScrollBarImageColor3 = accent

    tween(lockTitle, 0.25, {TextColor3 = accent})
    tween(playerCountLabel, 0.25, {TextColor3 = accent})
    tween(toastStroke, 0.25, {Color = accent})
    headerGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.deep),
        ColorSequenceKeypoint.new(0.55, accentSoft),
        ColorSequenceKeypoint.new(1, theme.deep),
    })
    frameStrokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, COLORS.text),
        ColorSequenceKeypoint.new(0.28, accent),
        ColorSequenceKeypoint.new(0.72, accentSoft),
        ColorSequenceKeypoint.new(1, COLORS.text),
    })

    for _, object in ipairs(frame:GetDescendants()) do
        if object:IsA("UIStroke") then
            object.Color = accent
        end
    end

    for _, slider in ipairs(sliders) do
        slider.fill.BackgroundColor3 = accent
        slider.fillGradient.Color = ColorSequence.new(COLORS.text, accent)
        slider.knobStroke.Color = accent
    end

    for button, meta in pairs(buttonMeta) do
        if button.Parent then
            -- Every "selected" button that uses the accent fill (part
            -- buttons, lock, speed, flight, player rows, ESP toggles)
            -- is re-tinted to the new accent.
            if meta.active and meta.activeTextColor == COLORS.background then
                meta.activeColor = accent
            end
            paintButton(button, false)
        end
    end

    setButtonActive(purpleButton, name == "Purple")
    setButtonActive(greenButton, name == "Green")
    updatePartButtons()
    refreshSpeedUI()
    refreshFlightUI()
    refreshEspUI()
    refreshPlayerRows()
end


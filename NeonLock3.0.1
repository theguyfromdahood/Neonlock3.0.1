local function unbindAction(action)
    local button = (action == "GUI") and guiKeyButton or bindButtons[action]

    -- If this bind was waiting for a key press, stop waiting.
    if listening == action then
        listening = nil
        listeningButton = nil
        if button then
            setButtonActive(button, false)
        end
    end

    if action == "Lock" then
        lockKey = nil
    elseif action == "Random" then
        randomKey = nil
    elseif action == "Speed" then
        speedKey = nil
    elseif action == "Flight" then
        flightKey = nil
    elseif action == "GUI" then
        guiKey = nil
    end

    refreshBindButtonNames()

    if action == "Lock" and locked then
        setButtonActive(lockButton, true, accent, COLORS.background)
    end

    showToast(action:upper() .. " KEY UNBOUND", COLORS.muted)
end


    Enum.RenderPriority.Camera.Value + 1,
    function(dt)
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if speedEnabled and not flightEnabled and root and humanoid
            and humanoid.MoveDirection.Magnitude > 0 then
            root.CFrame = root.CFrame + humanoid.MoveDirection * walkSpeed * dt
        end

        if not locked then
            return
        end

        if not lockedPlayer or lockedPlayer.Parent ~= Players then
            unlock()
            return
        end

        character = lockedPlayer.Character
        if not character then
            lockedCharacter = nil
            lockedPart = nil
            setStatus("LOCKED  /  WAITING FOR RESPAWN", COLORS.warning)
            return
        end

        if character ~= lockedCharacter then
            lockedCharacter = character
            lockedPart = nil
            updateLockedPart()
        end

        if not lockedPart or not lockedPart.Parent then
            updateLockedPart()
            if not lockedPart then
                return
            end
        end

        local targetHumanoid = lockedCharacter:FindFirstChildOfClass("Humanoid")
        if not targetHumanoid or targetHumanoid.Health <= 0 then
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local targetPosition = lockedPart.Position
            + lockedPart.AssemblyLinearVelocity * prediction
        local desired = CFrame.lookAt(camera.CFrame.Position, targetPosition)

        local alpha
        if smoothness <= 0 then
            alpha = 1
        else
            local response = 30 / (1 + smoothness * 0.65)
            alpha = 1 - math.exp(-response * dt)
        end

        camera.CFrame = camera.CFrame:Lerp(desired, alpha)
    end
)

---------------------------------------------------------------------
-- FLIGHT MOVEMENT
---------------------------------------------------------------------

RunService:BindToRenderStep(
    "NeonLockFlight",
    Enum.RenderPriority.Character.Value + 1,
    function(dt)
        if not flightEnabled then
            return
        end

        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local camera = workspace.CurrentCamera

        if not root or not humanoid or not camera then
            return
        end

        humanoid:ChangeState(Enum.HumanoidStateType.Physics)

        local move = Vector3.zero
        local look = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        -- IsKeyDown ignores text focus, so don't fly while typing.
        if UIS:GetFocusedTextBox() == nil then
            if UIS:IsKeyDown(Enum.KeyCode.W) then move += look end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move -= look end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move += right end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move -= right end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end
        end

        if move.Magnitude > 0 then
            root.CFrame = root.CFrame + move.Unit * flightSpeed * dt
        end

        root.AssemblyLinearVelocity = Vector3.zero
    end
)

---------------------------------------------------------------------
-- RESPAWN / THEME INITIALIZATION / CLEANUP
---------------------------------------------------------------------

remember(player.CharacterAdded:Connect(function()
    task.wait(0.2)
    if flightEnabled then
        flightEnabled = false
        refreshFlightUI()
    end
end))

syncShadowPosition()
updatePartButtons()
refreshBindButtonNames()
refreshSpeedUI()
refreshFlightUI()
refreshEspUI()
rebuildPlayerList()
setButtonActive(purpleButton, true)
setButtonActive(guiToggleButton, true)
setButtonActive(listToggleButton, true)
selectTab(true)

local cleanupDone = false
local function cleanup()
    if cleanupDone then
        return
    end
    cleanupDone = true

    RunService:UnbindFromRenderStep("NeonLockCamera")
    RunService:UnbindFromRenderStep("NeonLockFlight")
    RunService:UnbindFromRenderStep("NeonLockESP")

    for _, connection in ipairs(connections) do
        if connection.Connected then
            connection:Disconnect()
        end
    end

    for index = #animations, 1, -1 do
        local animation = animations[index]
        pcall(function()
            animation:Cancel()
        end)
    end

    -- Remove ESP highlights (they live inside the other characters) and
    -- the ESP overlay.
    for other, obj in pairs(espObjects) do
        pcall(function()
            destroyEsp(obj)
        end)
        espObjects[other] = nil
    end
    if espGui.Parent then
        espGui:Destroy()
    end
end

remember(script.Destroying:Connect(cleanup))
remember(gui.Destroying:Connect(cleanup))

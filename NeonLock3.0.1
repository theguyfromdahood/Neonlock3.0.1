local toastToken = 0
local function showToast(message, color)
    toastToken += 1
    local token = toastToken
    local tint = color or accent

    toastFrame.Visible = true
    toastFrame.Position = UDim2.new(0.5, 0, 0, -53)
    toastFrame.BackgroundTransparency = 1
    toastText.Text = message
    toastText.TextTransparency = 1
    toastDot.BackgroundColor3 = tint
    toastDot.BackgroundTransparency = 1
    toastStroke.Color = tint
    toastStroke.Transparency = 1

    tween(toastFrame, 0.2, {
        Position = UDim2.new(0.5, 0, 0, -43),
        BackgroundTransparency = 0.08,
    }, Enum.EasingStyle.Back)
    tween(toastText, 0.18, {TextTransparency = 0})
    tween(toastDot, 0.18, {BackgroundTransparency = 0})
    tween(toastStroke, 0.18, {Transparency = 0.18})

    task.delay(1.65, function()
        if token ~= toastToken or not toastFrame.Parent then
            return
        end
        tween(toastFrame, 0.18, {
            Position = UDim2.new(0.5, 0, 0, -53),
            BackgroundTransparency = 1,
        })
        tween(toastText, 0.14, {TextTransparency = 1})
        tween(toastDot, 0.14, {BackgroundTransparency = 1})
        tween(toastStroke, 0.14, {Transparency = 1})
        task.delay(0.2, function()
            if token == toastToken and toastFrame.Parent then
                toastFrame.Visible = false
            end
        end)
    end)
end


---------------------------------------------------------------------
-- TARGET SEARCH / LOCK
---------------------------------------------------------------------

local function getTarget()
    local camera = workspace.CurrentCamera
    if not camera then
        return nil, nil
    end

    -- GetMouseLocation and WorldToViewportPoint are both in viewport space
    -- (origin = top-left of the whole window), so they compare directly.
    local mousePosition = UIS:GetMouseLocation()
    local bestDistance = 150
    local bestPart = nil
    local bestCharacter = nil

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local character = other.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local selected = parts[partIndex]
            local target = character:FindFirstChild(selected.r15)
                or character:FindFirstChild(selected.r6)

            if humanoid and humanoid.Health > 0
                and target and target:IsA("BasePart") then
                local viewportPosition, visible = camera:WorldToViewportPoint(target.Position)
                if visible and viewportPosition.Z > 0 then
                    local distance = (
                        Vector2.new(viewportPosition.X, viewportPosition.Y) - mousePosition
                    ).Magnitude
                    if distance < bestDistance then
                        bestDistance = distance
                        bestPart = target
                        bestCharacter = character
                    end
                end
            end
        end
    end

    return bestPart, bestCharacter
end

local function unlock()
    locked = false
    lockedPart = nil
    lockedCharacter = nil
    lockedPlayer = nil
    setStatus("READY  /  UNLOCKED", COLORS.muted)
    setButtonActive(lockButton, false)
    if refreshPlayerRows then
        refreshPlayerRows()
    end
    showToast("TARGET UNLOCKED", COLORS.muted)
end

-- Lock the camera onto a specific player (the selected target).
local function startLock(target)
    if not target or target.Parent ~= Players or target == player then
        return false
    end

    locked = true
    lockedPlayer = target
    lockedCharacter = target.Character
    lockedPart = nil
    setButtonActive(lockButton, true, accent, COLORS.background)

    if lockedCharacter then
        updateLockedPart()
    else
        setStatus("LOCKED  /  WAITING FOR RESPAWN", COLORS.warning)
    end

    if refreshPlayerRows then
        refreshPlayerRows()
    end
    showToast("LOCKED  /  " .. target.DisplayName, COLORS.good)
    return true
end

-- Clears the selected target (and releases the camera lock if it was on them).
local function clearSelection()
    if not selectedPlayer then
        showToast("NO TARGET SELECTED", COLORS.muted)
        return
    end

    local clearedPlayer = selectedPlayer
    selectedPlayer = nil
    if locked and lockedPlayer == clearedPlayer then
        unlock()
    end
    if refreshPlayerRows then
        refreshPlayerRows()
    end
    showToast("TARGET CLEARED", COLORS.muted)
end

-- Select (or deselect) a player as the target. This never locks and never
-- changes who you are locked onto.
local function selectPlayer(target)
    if not target or target.Parent ~= Players or target == player then
        return
    end

    if selectedPlayer == target then
        clearSelection()
        return
    end

    selectedPlayer = target
    if refreshPlayerRows then
        refreshPlayerRows()
    end
    showToast("TARGET  /  " .. target.DisplayName, accent)
end

local function toggleLock()
    if locked then
        unlock()
        return
    end

    -- Player nearest the cursor first; this does not select them in the list.
    local target, character = getTarget()
    local targetPlayer = character and Players:GetPlayerFromCharacter(character)
    if target and targetPlayer and startLock(targetPlayer) then
        return
    end

    -- Nobody near the cursor: fall back to the selected player, if any.
    if selectedPlayer and startLock(selectedPlayer) then
        return
    end

    setStatus("NO TARGET  /  AIM CLOSER TO A PLAYER", COLORS.warning)
    showToast("NO TARGET IN RANGE", COLORS.warning)
end


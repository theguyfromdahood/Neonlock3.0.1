-- Keeps one row per player (created on join, destroyed on leave) and just
-- re-sorts / shows / hides them for the search filter. `ignore` is used by
-- PlayerRemoving, where the leaving player is still in GetPlayers().
local function rebuildPlayerList(ignore)
    local others = {}
    local present = {}
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other ~= ignore then
            table.insert(others, other)
            present[other] = true
        end
    end

    table.sort(others, function(a, b)
        return string.lower(a.DisplayName) < string.lower(b.DisplayName)
    end)

    for other, row in pairs(playerRows) do
        if not present[other] then
            buttonMeta[row] = nil
            row:Destroy()
            playerRows[other] = nil
        end
    end

    local query = string.lower((searchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")))
    query = (query:gsub("^@", ""))

    local shown = 0
    for index, other in ipairs(others) do
        if not playerRows[other] then
            createPlayerRow(other)
        end

        local row = playerRows[other]
        row.LayoutOrder = index

        local matches = query == ""
            or string.find(string.lower(other.DisplayName), query, 1, true) ~= nil
            or string.find(string.lower(other.Name), query, 1, true) ~= nil
        row.Visible = matches
        if matches then
            shown += 1
        end
    end

    emptyListLabel.Text = (#others == 0) and "NO OTHER PLAYERS" or "NO MATCHES"
    emptyListLabel.Visible = (shown == 0)
    if query == "" then
        playerCountLabel.Text = tostring(#others) .. (#others == 1 and " PLAYER" or " PLAYERS")
    else
        playerCountLabel.Text = tostring(shown) .. " / " .. tostring(#others)
    end
    refreshPlayerRows()
end

